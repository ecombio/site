<link rel="stylesheet" href="{{ 'product.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="{{ 'product.css' | asset_url }}"></noscript>
<script src="{{ 'product.js' | asset_url }}" defer></script>

{%- liquid
  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'main-product__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'main-product__full-width'
  else
    assign width_class = 'main-product__custom-width'
  endif

  assign gallery_image_width = 787
  assign featured_media = product.selected_or_first_available_variant.featured_image | default: product.featured_image
  assign current_variant = product.selected_or_first_available_variant
-%}

<div
  class="product-page {{ width_class }}"
  id="ProductSection"
  style="
    --section-padding: {{ section.settings.section_padding }}px;
    {%- if width_type == 'custom-width' %}
      --custom-width: {{ section.settings.custom_width }}rem;
    {%- endif %}
  "
>
  {%- comment -%} ═══ Breadcrumbs (formerly snippets/breadcrumbs.liquid) ═══ {%- endcomment -%}
  {%- liquid
    assign vendor_handle  = product.vendor | handleize
    assign parent_col     = nil
    assign child_col      = nil
    assign largest_count  = -1
    assign smallest_count = 999999

    for col in product.collections
      if col.handle != vendor_handle
        if col.all_products_count > largest_count
          assign parent_col    = col
          assign largest_count = col.all_products_count
        endif
      endif
    endfor

    for col in product.collections
      if col.handle != vendor_handle and col.handle != parent_col.handle
        if col.all_products_count < smallest_count
          assign child_col      = col
          assign smallest_count = col.all_products_count
        endif
      endif
    endfor
  -%}

  <nav class="breadcrumbs" role="navigation" aria-label="Breadcrumb">
    <div class="breadcrumbs-container">

      <a href="/">Home</a>

      {%- if parent_col -%}
        <span class="breadcrumb-divider" aria-hidden="true"><span class="divider-line"></span></span>
        <a href="{{ parent_col.url }}">{{ parent_col.title }}</a>
      {%- endif -%}

      {%- if child_col -%}
        <span class="breadcrumb-divider" aria-hidden="true"><span class="divider-line"></span></span>
        <a href="{{ child_col.url }}">{{ child_col.title }}</a>
      {%- endif -%}

      <span class="breadcrumb-divider" aria-hidden="true"><span class="divider-line"></span></span>
      <span class="breadcrumb-current" aria-current="page">{{ product.title }}</span>

    </div>
  </nav>

  <div class="product-layout">

    <div class="product-col product-col--left">

      <div class="product-gallery" id="ProductGallery">

        {%- if product.images.size > 1 -%}
          <div class="product-thumbnails">
            <div class="thumbnail-container">
              {%- for image in product.images -%}
                <div
                  class="thumbnail-item{% if forloop.first %} active{% endif %}"
                  data-index="{{ forloop.index0 }}"
                  data-image-src="{{ image | image_url: width: gallery_image_width }}"
                  data-image-alt="{{ image.alt | default: product.title | escape }}"
                  tabindex="0"
                  role="button"
                  aria-label="View image {{ forloop.index }}"
                  aria-pressed="{{ forloop.first | json }}"
                >
                  <div class="thumbnail-wrapper">
                    <img
                      src="{{ image | image_url: width: 84, height: 84, crop: 'center' }}"
                      alt="{{ image.alt | default: product.title | escape }}"
                      width="84"
                      height="84"
                      loading="lazy"
                      class="thumbnail-image"
                    >
                  </div>
                </div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <div class="product-gallery-main">
          <div class="gallery-viewer" id="GalleryViewer">
            <div class="main-image-container" id="MainImage">
              <img
                src="{{ featured_media | image_url: width: gallery_image_width }}"
                alt="{{ featured_media.alt | default: product.title | escape }}"
                width="{{ gallery_image_width }}"
                height="{{ gallery_image_width }}"
                loading="eager"
                class="main-image"
                id="FeaturedImage"
              >
            </div>
          </div>
        </div>

      </div>

      {%- comment -%} ═══ Feature grid (formerly snippets/feature-grid.liquid) ═══ {%- endcomment -%}
      {%- liquid
        assign feature_items = product.metafields.custom.feature_grid.value
      -%}
      {%- if feature_items != blank -%}
        <div class="feature-grid">
          {%- for item in feature_items -%}
            {%- if item.label.value == blank and item.description.value == blank -%}
              {%- continue -%}
            {%- endif -%}

            {%- assign has_link = false -%}
            {%- if item.link.value != blank -%}
              {%- assign has_link = true -%}
            {%- endif -%}

            {%- assign icon_alt = item.label.value | default: item.title.value | default: '' -%}

            {%- if has_link -%}
              <a
                href="{{ item.link.value }}"
                class="feature-tile"
                {% if item.title.value != blank %}title="{{ item.title.value | escape }}"{% endif %}
              >
            {%- else -%}
              <div
                class="feature-tile"
                {% if item.title.value != blank %}title="{{ item.title.value | escape }}"{% endif %}
              >
            {%- endif -%}

              {%- if item.icon.value != blank -%}
                <div class="feature-icon">
                  {{ item.icon.value | image_url: width: 96 | image_tag:
                    loading: 'lazy',
                    width: 48,
                    height: 48,
                    alt: icon_alt
                  }}
                </div>
              {%- endif -%}

              <div class="feature-text">
                {%- if item.label.value != blank -%}
                  <p class="feature-uptitle">{{ item.label.value }}</p>
                {%- endif -%}
                {%- if item.description.value != blank -%}
                  <p class="feature-headline">{{ item.description.value }}</p>
                {%- endif -%}
                {%- if item.subtitle.value != blank -%}
                  <p class="feature-subtitle">{{ item.subtitle.value }}</p>
                {%- endif -%}
              </div>

            {%- if has_link -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}

          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} ═══ Benefit grid (formerly snippets/benefit-grid.liquid) ═══ {%- endcomment -%}
      {%- liquid
        assign benefit_items = product.metafields.custom.benefits_grid.value
      -%}
      {%- if benefit_items != blank -%}
        <div class="benefit-grid">
          {%- for item in benefit_items -%}
            {%- if item.title.value == blank -%}
              {%- continue -%}
            {%- endif -%}

            {%- assign has_link = false -%}
            {%- if item.link.value.url != blank -%}
              {%- assign has_link = true -%}
            {%- endif -%}

            {%- assign has_tooltip = false -%}
            {%- if item.tooltip.value != blank -%}
              {%- assign has_tooltip = true -%}
            {%- endif -%}

            {%- if has_link -%}
              <a
                href="{{ item.link.value.url }}"
                class="benefit-item"
                target="_blank"
                rel="noopener noreferrer"
                {% if has_tooltip %}title="{{ item.tooltip.value | escape }}"{% endif %}
              >
            {%- else -%}
              <div
                class="benefit-item"
                {% if has_tooltip %}title="{{ item.tooltip.value | escape }}"{% endif %}
              >
            {%- endif -%}

              {%- if item.icon.value != blank -%}
                <div class="benefit-icon">
                  {{ item.icon.value | image_url: width: 48 | image_tag:
                    loading: 'lazy',
                    width: 24,
                    height: 24,
                    alt: ''
                  }}
                </div>
              {%- endif -%}

              <h3 class="benefit-title">{{ item.title.value }}</h3>

            {%- if has_link -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}

          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>

    <div class="product-col product-col--right product-col--scroll">

      <div class="product-info-wrapper" id="ProductInfo">

        <script>
          window.productVariants = {{ product.variants | json }};
          window.productOptions  = {{ product.options | json }};
        </script>

        <div class="product-header">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            {%- assign savings     = current_variant.compare_at_price | minus: current_variant.price -%}
            {%- assign savings_pct = savings | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
            <span class="product-badge">Save {{ savings_pct }}%</span>
          {%- endif -%}
          <h1 class="product-title">{{ product.title }}</h1>
        </div>

        <div class="product-reviews-badge">
          {%- comment -%} ═══ Star rating (formerly snippets/star-rating.liquid) ═══ {%- endcomment -%}
          {%- liquid
            assign rating_product = product
            if cart_item
              assign rating_product = cart_item.product
            endif

            assign active_provider = provider | default: settings.reviews_provider | default: 'yotpo'

            assign reviews_anchor = '#reviews'
            if active_provider == 'judgeme'
              assign reviews_anchor = '#judgeme_product_reviews'
            endif

            assign link_url = ''
            if rating_product
              assign link_url = rating_product.url | append: reviews_anchor
            endif
          -%}

          {%- capture widget_markup -%}
            {%- if active_provider == 'judgeme' -%}
              <div
                style='{{ jm_style }}'
                class='jdgm-widget jdgm-preview-badge'
                data-id='{{ rating_product.id }}'
                data-auto-install='false'
              >
                {{ rating_product.metafields.judgeme.badge }}
              </div>
            {%- else -%}
              {%- render 'yotpo-widgets', widget_type: 'yotpo_preview_badge', product: product, cart_item: cart_item -%}
            {%- endif -%}
          {%- endcapture -%}

          {%- if link_to_reviews == false or link_url == blank -%}
            {{ widget_markup }}
          {%- else -%}
            <a href="{{ link_url }}" class="star-rating-link">{{ widget_markup }}</a>
          {%- endif -%}
        </div>

        <div class="product-pricing">
          <div class="price-wrapper">
            <span
              class="price {% if current_variant.compare_at_price > current_variant.price %}sale-price{% endif %}"
              id="ProductPrice"
            >
              {{ current_variant.price | money }}
            </span>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              <span class="compare-price" id="ProductComparePrice">
                {{ current_variant.compare_at_price | money }}
              </span>
            {%- endif -%}
          </div>
        </div>

        {%- form 'product', product, id: 'ProductForm', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" id="ProductVariantId">

          <div class="product-variants">

            {%- assign color_option = product.options_with_values | where: 'name', 'Color' | first -%}
            {%- if color_option -%}
              {%- assign color_index = color_option.position | minus: 1 -%}
              <div class="variant-option">
                <label class="variant-label">
                  Color: <span class="selected-value" id="SelectedColor">{{ current_variant.options[color_index] }}</span>
                </label>
                <fieldset class="variant-fieldset">
                  <legend class="visually-hidden">Color</legend>
                  <div class="color-swatches">
                    {%- for value in color_option.values -%}
                      {%- assign swatch_color = value | handle -%}
                      <label class="color-swatch-label" title="{{ value | escape }}">
                        <input
                          type="radio"
                          name="Color"
                          value="{{ value | escape }}"
                          class="color-input"
                          {% if current_variant.options[color_index] == value %}checked{% endif %}
                          aria-label="{{ value | escape }}"
                        >
                        <span
                          class="color-swatch"
                          style="background-color: var(--swatch-{{ swatch_color }}, #ccc);"
                          data-swatch="{{ swatch_color }}"
                        ></span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              </div>
            {%- endif -%}

            {%- for option in product.options_with_values -%}
              {%- if option.name == 'Color' -%}{%- continue -%}{%- endif -%}
              {%- assign option_index = option.position | minus: 1 -%}
              <div class="variant-option">
                <label class="variant-label">
                  {{ option.name }}: <span class="selected-value" id="Selected{{ option.name | handleize | capitalize }}">{{ current_variant.options[option_index] }}</span>
                </label>
                <fieldset class="variant-fieldset">
                  <legend class="visually-hidden">{{ option.name }}</legend>
                  <div class="variant-buttons">
                    {%- for value in option.values -%}
                      <label>
                        <input
                          type="radio"
                          name="{{ option.name }}"
                          value="{{ value | escape }}"
                          class="variant-radio"
                          {% if current_variant.options[option_index] == value %}checked{% endif %}
                          aria-label="{{ value | escape }}"
                        >
                        <span class="variant-button">{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              </div>
            {%- endfor -%}

          </div>

          <div class="quantity-and-actions">
            <div class="quantity-actions-row">

              <div class="quantity-selector-wrapper">
                <label for="ProductQuantity" class="visually-hidden">Quantity</label>
                <div class="quantity-selector">
                  <button class="quantity-button" type="button" name="minus" aria-label="Decrease quantity">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M3.125 10H16.875" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </button>
                  <input
                    type="number"
                    id="ProductQuantity"
                    name="quantity"
                    value="1"
                    min="1"
                    max="{{ current_variant.inventory_quantity | default: 99 }}"
                    class="quantity-input"
                    aria-label="Quantity"
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                  <button class="quantity-button" type="button" name="plus" aria-label="Increase quantity">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M3.125 10H16.875M10 3.125V16.875" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                    </svg>
                  </button>
                </div>
              </div>

              <button
                type="submit"
                name="add"
                class="button button-primary add-to-cart"
                id="AddToCart"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                {%- if current_variant.available -%}Add To Cart{%- else -%}Sold Out{%- endif -%}
              </button>

            </div>
          </div>

        {%- endform -%}

        {%- form 'product', product, id: 'BuyNowForm', class: 'buy-now-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button
            type="submit"
            name="checkout"
            class="button button-secondary buy-now"
            id="BuyNow"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            Buy It Now
          </button>
        {%- endform -%}

        {%- comment -%} ═══ Description / Shipping / Refund / Warranty panels (formerly snippets/product-description.liquid) ═══ {%- endcomment -%}
        {%- liquid
          assign has_description = false
          assign has_shipping    = false
          assign has_refund      = false
          assign has_warranty    = false

          if product.description != blank
            assign has_description = true
          endif

          assign shipping_page = pages['shipping-policy']
          assign refund_page   = pages['refund-policy']
          assign warranty_page = pages['warranty']

          if shipping_page.content != blank
            assign has_shipping = true
          endif
          if refund_page.content != blank
            assign has_refund = true
          endif
          if warranty_page.content != blank
            assign has_warranty = true
          endif

          assign policy = product.metafields.custom.product_policy.value

          assign has_custom_shipping = false
          assign has_custom_refund   = false
          assign has_custom_warranty = false

          if policy.shipping_policy.value != blank
            assign has_custom_shipping = true
          endif
          if policy.returns_refunds.value != blank
            assign has_custom_refund = true
          endif
          if policy.warranty_policy.value != blank
            assign has_custom_warranty = true
          endif

          assign show_shipping = false
          assign show_refund   = false
          assign show_warranty = false

          if has_custom_shipping or has_shipping or shop.shipping_policy.body != blank
            assign show_shipping = true
          endif
          if has_custom_refund or has_refund or shop.refund_policy.body != blank
            assign show_refund = true
          endif
          if has_custom_warranty or has_warranty
            assign show_warranty = true
          endif
        -%}

        <div class="pd-wrap">

          {%- if has_description -%}
          <div class="pd-row">
            <button class="pd-trigger" type="button" id="PdTriggerDescription" aria-haspopup="dialog" aria-expanded="false" aria-controls="PdPanelDescription">
              <span>Description</span>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          {%- endif -%}

          {%- if show_shipping -%}
          <div class="pd-row">
            <button class="pd-trigger" type="button" id="PdTriggerShipping" aria-haspopup="dialog" aria-expanded="false" aria-controls="PdPanelShipping">
              <span>Shipping Policy</span>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          {%- endif -%}

          {%- if show_refund -%}
          <div class="pd-row">
            <button class="pd-trigger" type="button" id="PdTriggerRefund" aria-haspopup="dialog" aria-expanded="false" aria-controls="PdPanelRefund">
              <span>Refund &amp; Return Policy</span>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          {%- endif -%}

          {%- if show_warranty -%}
          <div class="pd-row">
            <button class="pd-trigger" type="button" id="PdTriggerWarranty" aria-haspopup="dialog" aria-expanded="false" aria-controls="PdPanelWarranty">
              <span>Warranty</span>
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          {%- endif -%}

        </div>

        <div class="pd-overlay" id="PdOverlay" aria-hidden="true"></div>

        {%- if has_description -%}
        <div class="pd-panel" id="PdPanelDescription" role="dialog" aria-modal="true" aria-labelledby="PdTitleDescription" aria-hidden="true" tabindex="-1">
          <div class="pd-panel__header">
            <h2 class="pd-panel__title" id="PdTitleDescription">Description</h2>
            <button class="pd-panel__close" type="button" aria-label="Close"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
          </div>
          <div class="pd-panel__body">{{ product.description }}</div>
        </div>
        {%- endif -%}

        {%- if show_shipping -%}
        <div class="pd-panel" id="PdPanelShipping" role="dialog" aria-modal="true" aria-labelledby="PdTitleShipping" aria-hidden="true" tabindex="-1">
          <div class="pd-panel__header">
            <h2 class="pd-panel__title" id="PdTitleShipping">Shipping Policy</h2>
            <button class="pd-panel__close" type="button" aria-label="Close"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
          </div>
          <div class="pd-panel__body">
            {%- if has_custom_shipping -%}
              {{ policy.shipping_policy | metafield_tag }}
            {%- elsif has_shipping -%}
              {{ shipping_page.content }}
            {%- else -%}
              {{ shop.shipping_policy.body }}
            {%- endif -%}
          </div>
        </div>
        {%- endif -%}

        {%- if show_refund -%}
        <div class="pd-panel" id="PdPanelRefund" role="dialog" aria-modal="true" aria-labelledby="PdTitleRefund" aria-hidden="true" tabindex="-1">
          <div class="pd-panel__header">
            <h2 class="pd-panel__title" id="PdTitleRefund">Refund &amp; Return Policy</h2>
            <button class="pd-panel__close" type="button" aria-label="Close"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
          </div>
          <div class="pd-panel__body">
            {%- if has_custom_refund -%}
              {{ policy.returns_refunds | metafield_tag }}
            {%- elsif has_refund -%}
              {{ refund_page.content }}
            {%- else -%}
              {{ shop.refund_policy.body }}
            {%- endif -%}
          </div>
        </div>
        {%- endif -%}

        {%- if show_warranty -%}
        <div class="pd-panel" id="PdPanelWarranty" role="dialog" aria-modal="true" aria-labelledby="PdTitleWarranty" aria-hidden="true" tabindex="-1">
          <div class="pd-panel__header">
            <h2 class="pd-panel__title" id="PdTitleWarranty">Warranty</h2>
            <button class="pd-panel__close" type="button" aria-label="Close"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
          </div>
          <div class="pd-panel__body">
            {%- if has_custom_warranty -%}
              {{ policy.warranty_policy | metafield_tag }}
            {%- elsif has_warranty -%}
              {{ warranty_page.content }}
            {%- else -%}
              <p>Please contact us for warranty information.</p>
            {%- endif -%}
          </div>
        </div>
        {%- endif -%}

        {%- comment -%} ═══ Sticky Add-to-Cart bar (formerly snippets/sticky-atc.liquid) ═══ {%- endcomment -%}
        {%- liquid
          assign sticky_featured_image = current_variant.featured_image | default: product.featured_image
        -%}

        <div class="sticky-atc" id="StickyAtc" aria-hidden="true" aria-label="Quick purchase bar">
          <div class="sticky-atc__inner">

            <!-- Left: Image + Info -->
            <div class="sticky-atc__product">
              <div class="sticky-atc__image-wrap">
                <img
                  src="{{ sticky_featured_image | image_url: width: 96 }}"
                  alt="{{ sticky_featured_image.alt | default: product.title | escape }}"
                  width="48"
                  height="48"
                  loading="lazy"
                  class="sticky-atc__image"
                  id="StickyAtcImage"
                >
              </div>
              <div class="sticky-atc__meta">
                <p class="sticky-atc__title">{{ product.title }}</p>
                <p class="sticky-atc__price" id="StickyAtcPrice">
                  <span class="sticky-atc__price-current{% if current_variant.compare_at_price > current_variant.price %} sale-price{% endif %}" id="StickyAtcPriceCurrent">
                    {{ current_variant.price | money }}
                  </span>
                  {%- if current_variant.compare_at_price > current_variant.price -%}
                    <span class="sticky-atc__price-compare" id="StickyAtcPriceCompare">
                      {{ current_variant.compare_at_price | money }}
                    </span>
                  {%- endif -%}
                </p>
              </div>
            </div>

            <!-- Centre: Variant Selectors -->
            <div class="sticky-atc__variants" id="StickyAtcVariants">

              {%- assign sticky_color_option = product.options_with_values | where: 'name', 'Color' | first -%}
              {%- if sticky_color_option -%}
                {%- assign sticky_color_index = sticky_color_option.position | minus: 1 -%}
                <div class="sticky-atc__option">
                  <span class="sticky-atc__option-label">
                    Color: <span class="sticky-atc__option-value" id="StickySelectedColor">{{ current_variant.options[sticky_color_index] }}</span>
                  </span>
                  <div class="sticky-atc__swatches">
                    {%- for value in sticky_color_option.values -%}
                      {%- assign sticky_swatch_color = value | handle -%}
                      <label class="sticky-atc__swatch-label" title="{{ value | escape }}">
                        <input
                          type="radio"
                          name="sticky-Color"
                          value="{{ value | escape }}"
                          class="sticky-atc__swatch-input"
                          data-option-name="Color"
                          {% if current_variant.options[sticky_color_index] == value %}checked{% endif %}
                          aria-label="{{ value | escape }}"
                        >
                        <span class="sticky-atc__swatch" style="background-color: var(--swatch-{{ sticky_swatch_color }}, #ccc);"></span>
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endif -%}

              {%- for option in product.options_with_values -%}
                {%- if option.name == 'Color' -%}{%- continue -%}{%- endif -%}
                {%- assign sticky_option_index = option.position | minus: 1 -%}
                <div class="sticky-atc__option">
                  <span class="sticky-atc__option-label">
                    {{ option.name }}: <span class="sticky-atc__option-value" id="StickySelected{{ option.name | handleize | capitalize }}">{{ current_variant.options[sticky_option_index] }}</span>
                  </span>
                  <div class="sticky-atc__buttons">
                    {%- for value in option.values -%}
                      <label class="sticky-atc__btn-label">
                        <input
                          type="radio"
                          name="sticky-{{ option.name | escape }}"
                          value="{{ value | escape }}"
                          class="sticky-atc__radio"
                          data-option-name="{{ option.name | escape }}"
                          {% if current_variant.options[sticky_option_index] == value %}checked{% endif %}
                          aria-label="{{ value | escape }}"
                        >
                        <span class="sticky-atc__btn">{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}

            </div>

            <!-- Right: Actions -->
            <div class="sticky-atc__actions">
              <button
                type="button"
                class="sticky-atc__cta sticky-atc__cta--atc"
                id="StickyAtcBtn"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                {%- if current_variant.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
              </button>

              {%- form 'product', product, id: 'StickyBuyNowForm', class: 'sticky-atc__bin-form' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" id="StickyVariantId">
                <input type="hidden" name="quantity" value="1">
                <button
                  type="submit"
                  name="checkout"
                  class="sticky-atc__cta sticky-atc__cta--bin"
                  id="StickyBuyNow"
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  Buy Now
                </button>
              {%- endform -%}
            </div>

          </div>
        </div>

      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Main product",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Section width",
      "options": [
        { "value": "", "label": "Default" },
        { "value": "full-width", "label": "Full width" },
        { "value": "custom-width", "label": "Custom width" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 40,
      "max": 120,
      "step": 5,
      "unit": "rem",
      "default": 80,
      "visible_if": "{{ section.settings.section_width == 'custom-width' }}"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Side padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    }
  ]
}
{% endschema %}
