{{ 'main-collection.css' | asset_url | stylesheet_tag }}
{{ 'accordion.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign active_tab = request.query_parameters['tab'] | default: 'products'
  unless active_tab == 'products' or active_tab == 'articles'
    assign active_tab = 'products'
  endunless

  assign active_filter_count = 0
  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
  endfor

  assign width_type = section.settings.section_width
  if width_type == blank
    assign width_class = 'collection-page__default-width'
  elsif width_type == 'full-width'
    assign width_class = 'collection-page__custom-width'
  else
    assign width_class = 'collection-page__custom-width'
  endif
-%}

<div class="main-collection" id="main-collection" data-section-id="{{ section.id }}">

  <div
    class="collection-page {{ width_class }}"
    style="
      --section-padding: {{ section.settings.section_padding }}px;
      {%- if width_type == 'custom-width' %}
        --custom-width: {{ section.settings.custom_width }}rem;
      {%- endif %}
    "
  >

    <div class="collection-hero" id="collection-hero">
      <h1 class="collection-title">{{ collection.title }}</h1>

      {%- if collection.description != blank -%}
        <div class="collection-description rte">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </div>

    <section class="collection-section">

      {%- comment -%} Inlined from snippets/collection-toolbar.liquid {%- endcomment -%}
      {{ 'collection-toolbar.css' | asset_url | stylesheet_tag }}

      <div
        class="collection-toolbar"
        id="collection-toolbar"
        role="navigation"
        aria-label="Collection navigation"
        data-active-tab="{{ active_tab }}"
      >

        <div class="tab-switcher" role="tablist" aria-label="Collection view">
          <button
            class="tab-switcher__tab{% if active_tab == 'products' %} tab-switcher__tab--active{% endif %}"
            role="tab"
            type="button"
            aria-selected="{% if active_tab == 'products' %}true{% else %}false{% endif %}"
            aria-controls="panel-products"
            id="tab-products"
            data-tab="products"
            tabindex="{% if active_tab == 'products' %}0{% else %}-1{% endif %}"
          >{{ section.settings.tab_products_label | default: 'Products' }}</button>

          <button
            class="tab-switcher__tab{% if active_tab == 'articles' %} tab-switcher__tab--active{% endif %}"
            role="tab"
            type="button"
            aria-selected="{% if active_tab == 'articles' %}true{% else %}false{% endif %}"
            aria-controls="panel-articles"
            id="tab-articles"
            data-tab="articles"
            tabindex="{% if active_tab == 'articles' %}0{% else %}-1{% endif %}"
          >{{ section.settings.tab_articles_label | default: 'Articles' }}</button>
        </div>

        {%- if section.settings.show_filters -%}
          <div
            class="collection-active-filters"
            id="collection-active-filters"
            aria-label="Active filters"
            {%- if active_filter_count == 0 %} hidden{%- endif %}
          >
            <div class="collection-active-filters__scroll">
              <button
                type="button"
                class="collection-active-filters__nav collection-active-filters__nav--prev"
                aria-label="Scroll active filters left"
                data-active-filters-prev
                hidden
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <div class="collection-active-filters__track" data-active-filters-track>
                {%- for filter in collection.filters -%}
                  {%- for value in filter.active_values -%}
                    <a href="{{ value.url_to_remove }}" class="collection-filter__pill">
                      {{ value.label }} &times;
                    </a>
                  {%- endfor -%}
                {%- endfor -%}

                {%- if active_filter_count > 0 -%}
                  <a href="{{ collection.url }}" class="collection-filter__pill collection-filter__pill--clear">Clear all</a>
                {%- endif -%}
              </div>

              <button
                type="button"
                class="collection-active-filters__nav collection-active-filters__nav--next"
                aria-label="Scroll active filters right"
                data-active-filters-next
                hidden
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.show_sort -%}
          <div class="collection-toolbar__sort">
            <label for="SortBy" class="visually-hidden">Sort</label>
            <select id="SortBy" data-sort>
              {%- for option in collection.sort_options -%}
                <option
                  value="{{ option.value }}"
                  {%- if option.value == collection.sort_by %} selected{%- endif %}
                >{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </div>
        {%- endif -%}

      </div>

      {%- if section.settings.show_filters or section.settings.show_sort -%}
        <div class="collection-mobile-bar" aria-label="Collection controls" role="toolbar">

          {%- if section.settings.show_filters -%}
            <button
              class="collection-mobile-bar__btn"
              type="button"
              aria-expanded="false"
              aria-controls="collection-filter"
              aria-label="Toggle filters"
              data-filter-toggle
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 4h12M4 8h8M6 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              Filters
            </button>
          {%- endif -%}

          {%- if section.settings.show_sort -%}
            <button
              class="collection-mobile-bar__btn"
              type="button"
              aria-expanded="false"
              aria-label="Sort products"
              data-mobile-sort-toggle
            >
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 4h8M2 8h6M2 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M12 3v10M9.5 10.5L12 13l2.5-2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Sort
            </button>
          {%- endif -%}

        </div>
      {%- endif -%}

      <script src="{{ 'collection-toolbar.js' | asset_url }}" defer></script>
      {%- comment -%} End inlined collection-toolbar {%- endcomment -%}

      <div class="collection-body{% unless section.settings.show_filters %} collection-body--filters-hidden{% endunless %}">

        {%- if section.settings.show_filters -%}
          {%- comment -%} Inlined from snippets/collection-filter.liquid {%- endcomment -%}
          {%- liquid
            if collection
              assign filters = collection.filters
              assign form_action = collection.url
              assign clear_url = collection.url
              assign remove_suffix = ''
            else
              assign filters = search.filters
              assign form_action = routes.search_url
              assign clear_url = routes.search_url | append: '?q=' | append: search_terms | append: '&type=' | append: result_type
              assign remove_suffix = '&type=' | append: result_type
            endif
          -%}


          <aside
            class="collection-filter"
            id="collection-filter"
            aria-label="Product filters"
          >

            <div class="collection-filter__header">
              <span class="collection-filter__heading">Filters</span>
              <button class="collection-filter__close-btn" type="button" aria-label="Close filters" data-filter-close>&times;</button>
            </div>

            <form method="get" action="{{ form_action }}" id="FilterForm">

              {%- unless collection -%}
                <input type="hidden" name="q" value="{{ search_terms }}">
                <input type="hidden" name="type" value="{{ result_type }}">
              {%- endunless -%}

              {%- for filter in filters -%}
                {%- assign group_body_id = 'CollectionFilterGroupBody-' | append: forloop.index -%}
                <div class="collection-filter__group" data-filter-group>
                  <button
                    type="button"
                    class="collection-filter__group-toggle"
                    aria-expanded="true"
                    aria-controls="{{ group_body_id }}"
                    data-group-toggle
                  >
                    <span class="collection-filter__group-label">
                      {{ filter.label }}
                      {%- if filter.active_values.size > 0 -%}
                        <span class="collection-filter__group-badge">{{ filter.active_values.size }}</span>
                      {%- endif -%}
                    </span>
                    <svg class="collection-filter__group-chevron" width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                      <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>

                  <div class="collection-filter__group-body" id="{{ group_body_id }}" data-group-body>
                    {%- case filter.type -%}
                      {%- when 'list' -%}
                        {%- for value in filter.values -%}
                          <label class="collection-filter__option
                            {%- if value.active %} collection-filter__option--active{%- endif %}
                            {%- if value.count == 0 and value.active == false %} collection-filter__option--disabled{%- endif %}">
                            <input
                              type="checkbox"
                              class="collection-filter__option-checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {%- if value.active %} checked{%- endif %}
                              {%- if value.count == 0 and value.active == false %} disabled{%- endif %}
                            >
                            {{ value.label }} <span>({{ value.count }})</span>
                          </label>
                        {%- endfor -%}

                      {%- when 'price_range' -%}
                        {%- assign range_max_cents = filter.range_max -%}
                        {%- assign range_max_num = range_max_cents | divided_by: 100.0 -%}
                        {%- assign range_max_dollars = range_max_cents | divided_by: 100 -%}
                        {%- assign range_max_cents_part = range_max_cents | modulo: 100 | prepend: '00' | slice: -2, 2 -%}
                        {%- assign range_max_decimal = range_max_dollars | append: '.' | append: range_max_cents_part -%}

                        {%- assign min_val_decimal = blank -%}
                        {%- if filter.min_value.value -%}
                          {%- assign min_dollars = filter.min_value.value | divided_by: 100 -%}
                          {%- assign min_cents_part = filter.min_value.value | modulo: 100 | prepend: '00' | slice: -2, 2 -%}
                          {%- assign min_val_decimal = min_dollars | append: '.' | append: min_cents_part -%}
                        {%- endif -%}

                        {%- assign max_val_decimal = blank -%}
                        {%- if filter.max_value.value -%}
                          {%- assign max_dollars = filter.max_value.value | divided_by: 100 -%}
                          {%- assign max_cents_part = filter.max_value.value | modulo: 100 | prepend: '00' | slice: -2, 2 -%}
                          {%- assign max_val_decimal = max_dollars | append: '.' | append: max_cents_part -%}
                        {%- endif -%}

                        <div class="collection-filter__price-wrap" data-price-filter>
                          <div class="collection-filter__price-fields">
                            <div class="collection-filter__price-field">
                              <label class="collection-filter__price-label" for="CollectionFilterPriceMin-{{ forloop.index }}">Min</label>
                              <div class="collection-filter__price-input-wrap">
                                <span class="collection-filter__price-symbol">$</span>
                                <input
                                  type="number"
                                  class="collection-filter__price-input"
                                  id="CollectionFilterPriceMin-{{ forloop.index }}"
                                  name="{{ filter.min_value.param_name }}"
                                  value="{{ min_val_decimal }}"
                                  min="0"
                                  max="{{ range_max_decimal }}"
                                  step="0.01"
                                  placeholder="0"
                                  data-price-input="min"
                                >
                              </div>
                            </div>

                            <span class="collection-filter__price-sep">&ndash;</span>

                            <div class="collection-filter__price-field">
                              <label class="collection-filter__price-label" for="CollectionFilterPriceMax-{{ forloop.index }}">Max</label>
                              <div class="collection-filter__price-input-wrap">
                                <span class="collection-filter__price-symbol">$</span>
                                <input
                                  type="number"
                                  class="collection-filter__price-input"
                                  id="CollectionFilterPriceMax-{{ forloop.index }}"
                                  name="{{ filter.max_value.param_name }}"
                                  value="{{ max_val_decimal }}"
                                  min="0"
                                  max="{{ range_max_decimal }}"
                                  step="0.01"
                                  placeholder="{{ range_max_decimal }}"
                                  data-price-input="max"
                                >
                              </div>
                            </div>
                          </div>

                          {%- assign bar_count = 16 -%}
                          {%- assign bin_width = range_max_num | divided_by: bar_count -%}
                          {%- if bin_width <= 0 -%}
                            {%- assign bin_width = 1 -%}
                          {%- endif -%}

                          {%- assign max_bucket_count = 0 -%}
                          {%- assign bucket_counts_str = '' -%}
                          {%- for bucket in (1..bar_count) -%}
                            {%- assign bucket_lower = bucket | minus: 1 | times: bin_width -%}
                            {%- assign bucket_upper = bucket | times: bin_width -%}
                            {%- assign bucket_count = 0 -%}
                            {%- for product in collection.products limit: 50 -%}
                              {%- assign p_price = product.price_min | divided_by: 100.0 -%}
                              {%- if bucket == bar_count and p_price >= bucket_lower -%}
                                {%- assign bucket_count = bucket_count | plus: 1 -%}
                              {%- elsif p_price >= bucket_lower and p_price < bucket_upper -%}
                                {%- assign bucket_count = bucket_count | plus: 1 -%}
                              {%- endif -%}
                            {%- endfor -%}
                            {%- assign bucket_counts_str = bucket_counts_str | append: bucket_count | append: ',' -%}
                            {%- if bucket_count > max_bucket_count -%}
                              {%- assign max_bucket_count = bucket_count -%}
                            {%- endif -%}
                          {%- endfor -%}
                          {%- assign bucket_counts = bucket_counts_str | split: ',' -%}

                          <div class="collection-filter__histogram" aria-hidden="true">
                            {%- for bucket_count in bucket_counts -%}
                              {%- assign bar_height = 6 -%}
                              {%- if max_bucket_count > 0 -%}
                                {%- assign bar_height = bucket_count | times: 100 | divided_by: max_bucket_count | at_least: 6 -%}
                              {%- endif -%}
                              <span class="collection-filter__histogram-bar" style="height: {{ bar_height }}%"></span>
                            {%- endfor -%}
                          </div>

                          <div class="collection-filter__range-slider" data-range-slider>
                            <div class="collection-filter__range-track"></div>
                            <div class="collection-filter__range-track-active" data-range-active></div>
                            <input
                              type="range"
                              class="collection-filter__range-input collection-filter__range-input--min"
                              min="0"
                              max="{{ range_max_decimal }}"
                              step="0.01"
                              value="{{ min_val_decimal | default: 0 }}"
                              data-range-thumb="min"
                              aria-label="Minimum price"
                            >
                            <input
                              type="range"
                              class="collection-filter__range-input collection-filter__range-input--max"
                              min="0"
                              max="{{ range_max_decimal }}"
                              step="0.01"
                              value="{{ max_val_decimal | default: range_max_decimal }}"
                              data-range-thumb="max"
                              aria-label="Maximum price"
                            >
                          </div>

                          {%- assign quarter_cents = filter.range_max | divided_by: 4.0 -%}
                          {%- assign b1_cents = quarter_cents | round -%}
                          {%- assign b2_cents = quarter_cents | times: 2 | round -%}
                          {%- assign b3_cents = quarter_cents | times: 3 | round -%}
                          {%- assign b1_dollars = b1_cents | divided_by: 100 -%}
                          {%- assign b1_cents_part = b1_cents | modulo: 100 | prepend: '00' | slice: -2, 2 -%}
                          {%- assign b1 = b1_dollars | append: '.' | append: b1_cents_part -%}
                          {%- assign b2_dollars = b2_cents | divided_by: 100 -%}
                          {%- assign b2_cents_part = b2_cents | modulo: 100 | prepend: '00' | slice: -2, 2 -%}
                          {%- assign b2 = b2_dollars | append: '.' | append: b2_cents_part -%}
                          {%- assign b3_dollars = b3_cents | divided_by: 100 -%}
                          {%- assign b3_cents_part = b3_cents | modulo: 100 | prepend: '00' | slice: -2, 2 -%}
                          {%- assign b3 = b3_dollars | append: '.' | append: b3_cents_part -%}
                          <div class="collection-filter__price-brackets" role="radiogroup" aria-label="Price brackets">
                            <label class="collection-filter__price-option">
                              <input type="radio" name="price_bracket" data-price-bracket data-min="0" data-max="{{ b1 }}">
                              Less than {{ b1_cents | money }}
                            </label>
                            <label class="collection-filter__price-option">
                              <input type="radio" name="price_bracket" data-price-bracket data-min="{{ b1 }}" data-max="{{ b2 }}">
                              {{ b1_cents | money }} to {{ b2_cents | money }}
                            </label>
                            <label class="collection-filter__price-option">
                              <input type="radio" name="price_bracket" data-price-bracket data-min="{{ b2 }}" data-max="{{ b3 }}">
                              {{ b2_cents | money }} to {{ b3_cents | money }}
                            </label>
                            <label class="collection-filter__price-option">
                              <input type="radio" name="price_bracket" data-price-bracket data-min="{{ b3 }}" data-max="{{ range_max_decimal }}">
                              {{ b3_cents | money }} to {{ filter.range_max | money }}
                            </label>
                            <label class="collection-filter__price-option">
                              <input type="radio" name="price_bracket" data-price-bracket data-min="{{ range_max_decimal }}" data-max="">
                              More than {{ filter.range_max | money }}
                            </label>
                          </div>
                        </div>
                    {%- endcase -%}
                  </div>
                </div>
              {%- endfor -%}

              <button type="submit" class="collection-filter__submit">Apply</button>

            </form>

          </aside>

          <script src="{{ 'collection-filter.js' | asset_url }}" defer></script>
          {%- comment -%} End inlined collection-filter {%- endcomment -%}
        {%- endif -%}

        <div class="collection-body__feed">
          {%- comment -%} Inlined from snippets/collection-feed.liquid {%- endcomment -%}
          {{ 'product-card.css' | asset_url | stylesheet_tag }}
          {{ 'sub-collection.css' | asset_url | stylesheet_tag }}
          {{ 'promo-banner.css' | asset_url | stylesheet_tag }}
          {{ 'promo-carousel.css' | asset_url | stylesheet_tag }}
          {{ 'image-card.css' | asset_url | stylesheet_tag }}
          {{ 'article-card.css' | asset_url | stylesheet_tag }}

          <div class="collection-feed" id="collection-feed" data-collection-feed>

            <div
              id="panel-products"
              class="collection-feed__panel"
              role="tabpanel"
              aria-labelledby="tab-products"
              data-panel="products"
              {%- if active_tab != 'products' %} hidden{%- endif %}
            >
              {%- liquid
                assign banner_blocks   = section.blocks | where: 'type', 'promo_banner'
                assign carousel_blocks = section.blocks | where: 'type', 'promo_carousel'
              -%}

              {%- paginate collection.products by section.settings.products_per_page -%}

                <div id="product-feed" class="product-feed" style="--columns: {{ section.settings.columns | default: 4 }};">

                  {%- render 'sub-collection', collection: collection -%}

                  <div class="product-feed__grid">

                    {%- for product in collection.products -%}

                      {%- for banner in banner_blocks -%}
                        {%- assign banner_position = banner.settings.position | default: 0 -%}
                        {%- if banner_position > 0 and banner_position == forloop.parentloop.index -%}
                          {%- render 'promo-banner', block: banner -%}
                        {%- endif -%}
                      {%- endfor -%}

                      {%- for carousel in carousel_blocks -%}
                        {%- assign carousel_position = carousel.settings.position | default: 0 -%}
                        {%- if carousel_position > 0 and carousel_position == forloop.parentloop.index -%}
                          {%- render 'promo-carousel', block: carousel -%}
                        {%- endif -%}
                      {%- endfor -%}

                      {%- render 'product-card', product: product -%}

                    {%- else -%}
                      <p class="collection-empty">No products found.</p>
                    {%- endfor -%}

                    {%- assign product_count = collection.products.size -%}

                    {%- for banner in banner_blocks -%}
                      {%- assign banner_position = banner.settings.position | default: 0 -%}
                      {%- if banner_position > product_count and banner_position > 0 -%}
                        {%- render 'promo-banner', block: banner -%}
                      {%- endif -%}
                    {%- endfor -%}

                    {%- for carousel in carousel_blocks -%}
                      {%- assign carousel_position = carousel.settings.position | default: 0 -%}
                      {%- if carousel_position > product_count and carousel_position > 0 -%}
                        {%- render 'promo-carousel', block: carousel -%}
                      {%- endif -%}
                    {%- endfor -%}

                  </div>
                </div>

                {%- if paginate.pages > 1 -%}
                  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
                    {%- if paginate.previous -%}
                      <a href="{{ paginate.previous.url }}&tab=products" class="pagination__link">&larr; {{ 'general.pagination.previous' | t }}</a>
                    {%- endif -%}
                    {%- for part in paginate.parts -%}
                      {%- if part.is_link -%}
                        <a href="{{ part.url }}&tab=products" class="pagination__link">{{ part.title }}</a>
                      {%- else -%}
                        <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if paginate.next -%}
                      <a href="{{ paginate.next.url }}&tab=products" class="pagination__link">{{ 'general.pagination.next' | t }} &rarr;</a>
                    {%- endif -%}
                  </nav>
                {%- endif -%}

              {%- endpaginate -%}
            </div>

            <div
              id="panel-articles"
              class="collection-feed__panel"
              role="tabpanel"
              aria-labelledby="tab-articles"
              data-panel="articles"
              {%- if active_tab != 'articles' %} hidden{%- endif %}
            >
              {%- assign articles = collection.metafields.custom.posts.value -%}

              {%- if articles != blank -%}
                <div id="article-feed" class="article-feed">
                  {%- for article in articles -%}
                    {%- render 'article-card', article: article -%}
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>

          </div>

          <script src="{{ 'promo-carousel.js' | asset_url }}" defer></script>
          <script src="{{ 'collection-feed.js' | asset_url }}" defer></script>
          {%- comment -%} End inlined collection-feed {%- endcomment -%}
        </div>

      </div>

    </section>

    {%- assign after_items_field = collection.metafields.custom.after_item_lists -%}

    {%- if after_items_field.value != blank -%}
      <div class="after-items rte">
        {%- if after_items_field.type contains 'list' -%}
          {%- for after_page in after_items_field.value -%}
            {{ after_page.content }}
          {%- endfor -%}
        {%- else -%}
          {{ after_items_field.value.content }}
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>

  <div class="collection-mobile-backdrop" aria-hidden="true"></div>

</div>

<script src="{{ 'main-collection.js' | asset_url }}" defer></script>
<script src="{{ 'accordion.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Main collection",
  "tag": "section",
  "class": "section-collection",
  "settings": [
    {
      "type": "text",
      "id": "tab_products_label",
      "label": "Products tab label",
      "default": "Products"
    },
    {
      "type": "text",
      "id": "tab_articles_label",
      "label": "Articles tab label",
      "default": "Articles"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show filters",
